# SponsoredFPC address for testnet deployment — preferred over SPONSOR_FPC_SALT.
# The compiled SponsoredFPC class hash changes with each aztec-nr version, so a
# fixed salt produces a different address. Provide the address directly instead.
SPONSOR_FPC_ADDRESS="0x..."

# Fallback: derive FPC address from salt (hex string with 0x prefix).
# Only used if SPONSOR_FPC_ADDRESS is not set.
SPONSOR_FPC_SALT="0x..."
