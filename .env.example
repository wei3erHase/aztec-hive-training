# SponsoredFPC address for testnet deployment — preferred over SPONSOR_FPC_SALT.
# Must match the on-chain class bundled in @aztec/noir-contracts.js (see config.aztecVersion).
# Canonical genesis FPC for Aztec 4.3.0 (class 0x216c0b6e…):
SPONSOR_FPC_ADDRESS="0x08b888c4be63ed67f61a622fdd013ea028326bac22a8982a3b5a7e9ec62f765b"

# Fallback: derive FPC address from salt (hex string with 0x prefix).
# Only used if SPONSOR_FPC_ADDRESS is not set.
SPONSOR_FPC_SALT="0x..."
